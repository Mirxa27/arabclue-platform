  decisionAt         DateTime?
  decisionReasonAr   String?               @db.Text
  decisionReasonEn   String?               @db.Text
  revokedAt          DateTime?
  revokedById        String?
  revocationReason   String?               @db.Text
  contentHash        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

