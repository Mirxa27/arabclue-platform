  restrictionType String // CONFIDENTIAL_CLAUSE | COMPETITOR_NAME | OTHER
  text            String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OnboardingProgress {
  id                   String   @id @default(cuid())
  workspaceId          String   @unique
  completedSteps       String   @default("{}") // JSON record of step keys → true
  restrictionsReviewed Boolean  @default(false)
  readyForProposals    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
