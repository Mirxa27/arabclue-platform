  revoker               User?            @relation("MethodologyRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  evidenceVersionRecord DocumentVersion? @relation("MethodologyEvidence", fields: [evidenceDocumentId, evidenceVersion, evidenceChecksum], references: [documentId, version, checksum], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId])
  @@index([category])
