// Prisma schema for Arabclue — Saudi Government Tender Proposal Automation SaaS
// Production domain model: RBAC + MFA users, workspaces, tender projects,
// versioned documents, brand profiles, past projects (RAG), multi-agent runs,
// NCA/PDPL compliance checks, generated proposals, AI provider config,
// encrypted env settings, subscriptions/billing, and immutable audit trail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// SQL-only schema objects
// -----------------------
// The following protections are created by
// prisma/migrations/20260726000000_platform_completion/migration.sql because the
// Prisma schema language cannot express expression indexes, partial indexes, or
// CHECK constraints. They are intentionally absent from this file and must be
// kept in sync with that migration:
//   * User_email_normalized_key — unique on lower(btrim(email))
//   * WorkspaceInvitation_workspaceId_normalizedEmail_active_key — unique on
//     (workspaceId, lower(btrim(email))) where the invitation is still pending
//   * StandardClause_catalog_clauseKey_key — unique catalog clause key for
//     workspace-independent rows
//   * MyFatoorahRecurringProfile_subscriptionId_current_key — unique
//     subscription where status is DRAFT or ACTIVE
//   * NotificationDelivery_dispatch_ready_idx — partial dispatcher claim index
//   * Digest-version, analytics vocabulary/duration, template and contract
//     legal-safety, recurring value-literal, rating-range, delivery-attempt,
//     and knowledge decision-state CHECK constraints

enum KnowledgeReviewStatus {
  UNREVIEWED
  APPROVED
  REVOKED
}

// ─── Identity & Access (RBAC + MFA) ──────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               String    @default("BIDDER") // SUPER_ADMIN | ADMIN | BIDDER | REVIEWER | FINANCE
  mfaEnabled         Boolean   @default(false)
  mfaSecret          String?
  avatarUrl          String?
  locale             String    @default("ar") // ar | en
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  activeWorkspaceId  String?
  lastLoginAt        DateTime?
  emailVerified      Boolean   @default(false)
  emailVerifiedAt    DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspaces               WorkspaceMember[]
  projects                 TenderProject[]
  documents                UploadedDocument[]
  proposals                GeneratedProposal[]
  agentRuns                AgentRun[]
  sessions                 UserSession[]
  auditLogs                AuditLog[]
  billingRecords           BillingRecord[]
  paymentCheckouts         PaymentCheckout[]
  subscription             Subscription?
  approvalSteps            ApprovalStep[]
  proposalReviews          ProposalReview[]
  copilotMissions          CopilotMission[]
  copilotMessages          CopilotMessage[]
  copilotAttachments       CopilotAttachment[]
  copilotActions           CopilotAction[]
  notificationDismissals   NotificationDismissal[]
  obligationUpdates        ContractObligationState[]
  createdTemplates         ContractTemplate[]               @relation("TemplateCreator")
  approvedTemplates        ContractTemplate[]               @relation("TemplateApprover")
  templateVersions         ContractTemplateVersion[]
  generatedContracts       GeneratedContract[]
  reviewedPastProjects     PastProject[]                    @relation("PastProjectReviewer")
  revokedPastProjects      PastProject[]                    @relation("PastProjectRevoker")
  reviewedCertificates     Certificate[]                    @relation("CertificateReviewer")
  revokedCertificates      Certificate[]                    @relation("CertificateRevoker")
  reviewedMethodologies    MethodologyAsset[]               @relation("MethodologyReviewer")
  revokedMethodologies     MethodologyAsset[]               @relation("MethodologyRevoker")
  reviewedLibraryItems     ContentLibraryItem[]             @relation("LibraryItemReviewer")
  revokedLibraryItems      ContentLibraryItem[]             @relation("LibraryItemRevoker")
  updatedProposalSnapshots GeneratedProposal[]              @relation("ProposalSnapshotUpdater")
  builderSections          ProposalBuilderSection[]
  createdTemplatesMarket   TemplateMarketplaceEntry[]
  collaborationComments    CollaborationComment[]
  analyticsEvents          AnalyticsEvent[]
  verificationTokens       VerificationToken[]
  recoveryTokens           RecoveryToken[]
  sentInvitations          WorkspaceInvitation[]            @relation("InvitationInviter")
  contractVersions         GeneratedContractVersion[]
  marketplaceRatings       TemplateMarketplaceRating[]
  proposalPresences        ProposalPresence[]
  notificationDeliveries   NotificationDelivery[]
  inAppNotifications       InAppNotification[]
  recurringProfiles        MyFatoorahRecurringProfile[]
  recurringCheckoutIntents RecurringCheckoutIntent[]        @relation("RecurringCheckoutIntentCreator")
  marketplaceApplications  TemplateMarketplaceApplication[] @relation("MarketplaceApplicationActor")
  submittedPastProjects    PastProject[]                    @relation("PastProjectSubmitter")
  submittedCertificates    Certificate[]                    @relation("CertificateSubmitter")
  submittedMethodologies   MethodologyAsset[]               @relation("MethodologySubmitter")
  submittedLibraryItems    ContentLibraryItem[]             @relation("LibraryItemSubmitter")
  reviewedStaffMembers     StaffMember[]                    @relation("StaffMemberReviewer")
  submittedStaffMembers    StaffMember[]                    @relation("StaffMemberSubmitter")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Workspaces (multi-tenant) ───────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  slug      String   @unique
  plan      String   @default("ENTERPRISE") // STARTER | PRO | ENTERPRISE
  crNumber  String? // Commercial Registration
  vatNumber String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                  WorkspaceMember[]
  projects                 TenderProject[]
  documents                UploadedDocument[]
  brandProfiles            BrandProfile[]
  pastProjects             PastProject[]
  proposals                GeneratedProposal[]
  certificates             Certificate[]
  staffMembers             StaffMember[]
  methodologyAssets        MethodologyAsset[]
  contentLibrary           ContentLibraryItem[]
  partnerships             Partnership[]
  targetSectors            TargetSector[]
  bidHistoryNotes          BidHistoryNote[]
  approvalPolicy           ApprovalPolicy?
  restrictions             Restriction[]
  onboardingProgress       OnboardingProgress?
  copilotMissions          CopilotMission[]
  copilotAttachments       CopilotAttachment[]
  copilotActions           CopilotAction[]
  contractTemplates        ContractTemplate[]
  generatedContracts       GeneratedContract[]
  templateMarketplace      TemplateMarketplaceEntry[]
  analyticsEvents          AnalyticsEvent[]
  invitations              WorkspaceInvitation[]
  customClauses            StandardClause[]                 @relation("WorkspaceCustomClauses")
  proposalPresences        ProposalPresence[]
  inAppNotifications       InAppNotification[]
  recurringProfiles        MyFatoorahRecurringProfile[]
  recurringCheckoutIntents RecurringCheckoutIntent[]
  marketplaceApplications  TemplateMarketplaceApplication[]
  notificationDeliveries   NotificationDelivery[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER") // OWNER | ADMIN | MEMBER
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// ─── Tender Projects ─────────────────────────────────────────────────────────

model TenderProject {
  id                 String    @id @default(cuid())
  workspaceId        String
  createdById        String
  etimadRef          String? // Etimad tender reference number
  title              String
  titleAr            String?
  category           String? // IT | CONSULTING | CONSTRUCTION | MEDICAL | GENERAL
  budget             Float?
  currency           String    @default("SAR")
  submissionDeadline DateTime?
  status             String    @default("DRAFT") // DRAFT | PARSING | DRAFTING | REVIEW | SUBMITTED | ARCHIVED
  saudizationTarget  Float? // percentage
  localContentTarget Float? // percentage
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy          User                @relation(fields: [createdById], references: [id])
  documents          UploadedDocument[]
  proposals          GeneratedProposal[]
  agentRuns          AgentRun[]
  complianceChecks   ComplianceCheck[]
  requirements       TenderRequirement[]
  generatedContracts GeneratedContract[]

  @@index([workspaceId])
  @@index([status])
}

// ─── Uploaded Documents (versioned) ──────────────────────────────────────────

model UploadedDocument {
  id                String   @id @default(cuid())
  workspaceId       String
  projectId         String?
  uploadedById      String
  originalName      String
  storagePath       String
  mimeType          String
  sizeBytes         Int
  docCategory       String // RFP | TECHNICAL_SPECS | IT_CONTRACT | EA_COMPLIANCE | QUALIFICATION | FINANCIAL | BRAND_ASSET | OTHER
  docTypeAr         String?
  checksum          String?
  currentVersion    Int      @default(1)
  parseStatus       String   @default("PENDING") // PENDING | PARSING | PARSED | FAILED
  parsedSummary     String?
  extractedEntities String? // JSON blob of extracted SOW/SLA/milestones
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project            TenderProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id])
  versions           DocumentVersion[]
  chunks             DocumentChunk[]
  copilotAttachments CopilotAttachment[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([docCategory])
}

// ─── Voice Mission Control (durable Copilot sessions) ────────────────────────

model CopilotMission {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String
  title           String   @default("Mission Control")
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  activeProjectId String?
  locale          String   @default("ar")
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    CopilotMessage[]
  attachments CopilotAttachment[]
  actions     CopilotAction[]

  @@index([workspaceId, userId, status])
  @@index([userId, lastActivityAt])
}

model CopilotMessage {
  id        String   @id @default(cuid())
  missionId String
  userId    String?
  role      String // user | assistant | system
  partsJson String // JSON UIMessage parts / text payload
  createdAt DateTime @default(now())

  mission CopilotMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([missionId, createdAt])
}

model CopilotAttachment {
  id                 String   @id @default(cuid())
  missionId          String
  workspaceId        String
  userId             String
  documentId         String?
  projectId          String?
  source             String   @default("upload") // upload | url | camera | browser | email | drive | paste
  originalName       String
  mimeType           String
  sizeBytes          Int      @default(0)
  storagePath        String?
  textPreview        String?
  docCategory        String   @default("OTHER")
  confidence         Float    @default(0)
  routeStatus        String   @default("STAGED") // STAGED | ROUTED | AUTOPILOT | NEEDS_CLARIFICATION | FAILED | UNDONE
  classificationJson String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mission   CopilotMission    @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  UploadedDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([missionId, createdAt])
  @@index([workspaceId])
  @@index([documentId])
}

model CopilotAction {
  id          String   @id @default(cuid())
  missionId   String
  workspaceId String
  userId      String
  toolName    String
  status      String   @default("RUNNING") // RUNNING | SUCCEEDED | FAILED | UNDONE
  inputJson   String?
  outputJson  String?
  errorText   String?
  reversible  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission   CopilotMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([missionId, createdAt])
  @@index([workspaceId])
}

// RAG chunks from uploaded tender documents (RFP, specs, contracts, etc.)
model DocumentChunk {
  id            String   @id @default(cuid())
  documentId    String
  workspaceId   String
  projectId     String?
  chunkIndex    Int
  content       String
  embeddingJson String? // JSON number[] for dense retrieval
  createdAt     DateTime @default(now())

  document UploadedDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([workspaceId])
  @@index([projectId])
  @@index([documentId])
}

model DocumentVersion {
  id                  String               @id @default(cuid())
  documentId          String
  version             Int
  storagePath         String
  sizeBytes           Int
  changeLog           String?
  parsedSummary       String?
  extractedEntities   String?
  checksum            String?
  createdBy           String
  createdAt           DateTime             @default(now())
  document            UploadedDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pastProjectEvidence PastProject[]        @relation("PastProjectEvidence")
  certificateEvidence Certificate[]        @relation("CertificateEvidence")
  methodologyEvidence MethodologyAsset[]   @relation("MethodologyEvidence")
  libraryItemEvidence ContentLibraryItem[] @relation("LibraryItemEvidence")
  staffEvidence       StaffMember[]        @relation("StaffMemberEvidence")

  @@unique([documentId, version])
  @@unique([documentId, version, checksum])
  @@index([documentId])
  @@index([documentId, version(sort: Desc), id], map: "DocumentVersion_documentId_version_id_cursor_idx")
}

// ─── Brand Profiles & Past Projects (RAG corpus) ────────────────────────────

model BrandProfile {
  id                  String   @id @default(cuid())
  workspaceId         String
  logoUrl             String?
  primaryColor        String   @default("#1E3A8A")
  secondaryColor      String   @default("#0F172A")
  accentColor         String   @default("#0EA5E9")
  fontFamily          String   @default("IBM Plex Sans Arabic")
  tagline             String?
  taglineAr           String?
  vision2030Alignment String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pastProjects PastProject[]
}

model PastProject {
  id                 String                @id @default(cuid())
  workspaceId        String
  brandProfileId     String?
  title              String
  titleAr            String?
  clientName         String?
  clientNameAr       String?
  sector             String? // GOV | HEALTH | FINANCE | ENERGY | TELECOM | OTHER
  contractValue      Float?
  currency           String                @default("SAR")
  startDate          DateTime?
  endDate            DateTime?
  outcome            String? // SUCCESSFUL | ONGOING | COMPLETED
  summary            String // rich text / vectorized for RAG
  summaryAr          String?
  vectorId           String? // optional external vector store id
  embeddingJson      String? // JSON number[] embedding for local RAG
  tags               String? // comma-separated
  approved           Boolean               @default(false)
  reviewStatus       KnowledgeReviewStatus @default(UNREVIEWED)
  evidenceRef        String?
  evidenceDocumentId String?
  evidenceVersion    Int?
  evidenceChecksum   String?
  provenanceJson     String?               @db.Text
  reviewedById       String?
  approvedAt         DateTime?
  contentHash        String?
  decisionStatus     String                @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById      String?
  submittedAt        DateTime              @default(now())
  decisionAt         DateTime?
  decisionReasonAr   String?               @db.Text
  decisionReasonEn   String?               @db.Text
  revokedAt          DateTime?
  revokedById        String?
  revocationReason   String?               @db.Text
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brandProfile          BrandProfile?    @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  reviewer              User?            @relation("PastProjectReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  submitter             User?            @relation("PastProjectSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  revoker               User?            @relation("PastProjectRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  evidenceVersionRecord DocumentVersion? @relation("PastProjectEvidence", fields: [evidenceDocumentId, evidenceVersion, evidenceChecksum], references: [documentId, version, checksum], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId])
  @@index([sector])
  @@index([workspaceId, reviewStatus, approved])
  @@index([workspaceId, decisionStatus, submittedAt(sort: Desc), id])
  @@index([evidenceDocumentId, evidenceVersion])
}

// ─── Multi-Agent Workflow Runs ───────────────────────────────────────────────

model AgentRun {
  id              String    @id @default(cuid())
  projectId       String
  triggeredById   String
  status          String    @default("QUEUED") // QUEUED | RUNNING | COMPLETED | FAILED | CANCELLED
  startedAt       DateTime?
  completedAt     DateTime?
  overallProgress Float     @default(0) // 0-100
  agentStates     String? // JSON: per-agent status/progress/output
  finalArtifact   String? // JSON summary of generated artifacts
  configJson      String? // JSON: durable run config for resume (locale, workspace, regenerate mode)
  errorMessage    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project     TenderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggeredBy User          @relation(fields: [triggeredById], references: [id])

  @@index([projectId])
  @@index([status])
}

// ─── Compliance Checks (NCA / PDPL / EA) ────────────────────────────────────

model ComplianceCheck {
  id              String   @id @default(cuid())
  projectId       String
  framework       String // NCA_ECC1 | NCA_CCC1 | PDPL | EA_TP1 | EA_SP1 | EA_SP2 | LOCAL_CONTENT
  controlId       String // e.g. ECC-1.3, PDPL-14, TP1-CloudFirst
  title           String
  titleAr         String?
  requirement     String
  status          String   @default("PENDING") // PENDING | COMPLIANT | PARTIAL | NON_COMPLIANT | NOT_APPLICABLE
  complianceLevel String? // C1 (Full) | C2 (Substantial) | C3 (Partial)
  evidence        String?
  remediation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project TenderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([framework])
}

// ─── Generated Proposals ─────────────────────────────────────────────────────

model GeneratedProposal {
  id                             String    @id @default(cuid())
  workspaceId                    String
  projectId                      String
  createdById                    String
  parentProposalId               String? // lineage when forked from another proposal
  title                          String
  titleAr                        String?
  type                           String // TECHNICAL | FINANCIAL | EA_MATRIX | BOQ | COMBINED
  status                         String    @default("DRAFT") // DRAFT | GENERATED | REVIEW | REVIEWED | APPROVED | REJECTED | EXPORTED
  version                        Int       @default(1)
  contentMd                      String? // markdown content
  locale                         String    @default("ar") // ar | en — generation language
  artifactsJson                  String? // JSON: list of {type, filename, downloadPath}
  financialFormsJson             String? // JSON: user-entered BoQ amounts (never AI-filled)
  complianceScore                Float? // 0-100
  submittedAt                    DateTime?
  approvedAt                     DateTime?
  generatedAt                    DateTime?
  structuredSnapshot             Json?
  structuredSnapshotHash         String?
  structuredSnapshotRevision     Int       @default(0)
  structuredSnapshotPreset       String?
  structuredSnapshotUpdatedAt    DateTime?
  structuredSnapshotUpdatedById  String?
  contractRenderSnapshot         Json?
  contractRenderSnapshotHash     String?
  contractRenderSnapshotRevision Int       @default(0)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  workspace                   Workspace                        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project                     TenderProject                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy                   User                             @relation(fields: [createdById], references: [id])
  structuredSnapshotUpdatedBy User?                            @relation("ProposalSnapshotUpdater", fields: [structuredSnapshotUpdatedById], references: [id], onDelete: Restrict)
  parentProposal              GeneratedProposal?               @relation("ProposalLineage", fields: [parentProposalId], references: [id], onDelete: SetNull)
  childProposals              GeneratedProposal[]              @relation("ProposalLineage")
  versions                    ProposalVersion[]
  reviews                     ProposalReview[]
  obligationStates            ContractObligationState[]
  builderSections             ProposalBuilderSection[]
  collaborationComments       CollaborationComment[]
  presences                   ProposalPresence[]
  marketplaceApplications     TemplateMarketplaceApplication[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentProposalId])
  @@index([workspaceId, structuredSnapshotHash])
  @@index([workspaceId, contractRenderSnapshotHash])
}

model ProposalVersion {
  id         String            @id @default(cuid())
  proposalId String
  version    Int
  contentMd  String
  changeLog  String?
  locale     String            @default("ar")
  createdBy  String
  createdAt  DateTime          @default(now())
  proposal   GeneratedProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, version])
  @@index([proposalId])
  @@index([proposalId, version(sort: Desc), id], map: "ProposalVersion_proposalId_version_id_cursor_idx")
}

// ─── AI Provider & Model Configuration ───────────────────────────────────────

model AIProviderConfig {
  id                  String    @id @default(cuid())
  name                String // display name for the connection (e.g. "OpenAI Production")
  provider            String // zai | openai | anthropic | mistral | openai_compatible | ollama | azure_openai
  modelId             String    @default("") // selected from live /models fetch — never hardcoded
  apiBase             String? // OpenAI-compatible base URL ending in /v1 or host root
  apiKeyEnvKey        String? // EnvSetting / process.env key for the API token
  // Primary engine (first of enginesJson) — kept for indexes / backward compat
  engine              String    @default("DEFAULT") // DEFAULT | INGESTION | COMPLIANCE | TECHNICAL | FINANCIAL | DRAFTING | EMBEDDING | REWRITE | LAW | VOICE
  // JSON string[] of agent engines this connection serves (multi-select)
  enginesJson         String?
  isActive            Boolean   @default(false)
  isDefault           Boolean   @default(false)
  priority            Int       @default(0)
  // Model capabilities (auto-filled from live model list / heuristics)
  contextWindow       Int       @default(128000)
  supportsVision      Boolean   @default(false)
  supportsJsonMode    Boolean   @default(true)
  supportsTools       Boolean   @default(false)
  // Tunable parameters
  temperature         Float     @default(0.2)
  maxTokens           Int       @default(4096)
  topP                Float     @default(0.9)
  frequencyPenalty    Float     @default(0.0)
  presencePenalty     Float     @default(0.0)
  // Safety guardrails
  confidenceThreshold Float     @default(0.85)
  toxicityFilter      Boolean   @default(true)
  piiFilter           Boolean   @default(true)
  hallucinationGuard  Boolean   @default(true)
  maxRetries          Int       @default(2)
  timeoutMs           Int       @default(60000)
  // Cost tracking
  inputCostPer1k      Float     @default(0.0)
  outputCostPer1k     Float     @default(0.0)
  // Live model catalog cache (admin auto-fetch)
  modelsCacheJson     String? // JSON: ModelCapability[]
  modelsFetchedAt     DateTime?
  metadata            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([provider])
  @@index([isActive])
  @@index([engine])
  @@index([engine, isActive])
}

// ─── Encrypted Environment Settings (.env UI management) ─────────────────────

model EnvSetting {
  id             String    @id @default(cuid())
  key            String    @unique // e.g. OPENAI_API_KEY, DATABASE_URL, WEBHOOK_URL
  valueEncrypted String // AES-256-GCM encrypted ciphertext (iv:authTag:ciphertext)
  category       String    @default("GENERAL") // AI_PROVIDER | DATABASE | INTEGRATION | SECURITY | BILLING | GENERAL
  description    String?
  isSecret       Boolean   @default(true) // mask in UI
  isRequired     Boolean   @default(false)
  lastRotatedAt  DateTime?
  lastEditedBy   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
}

// ─── Subscriptions & Billing ─────────────────────────────────────────────────

model SubscriptionPlan {
  id                String   @id @default(cuid())
  name              String // STARTER | PRO | ENTERPRISE | PAY_AS_YOU_GO
  nameAr            String?
  description       String?
  priceMonthly      Float    @default(0.0) // SAR
  priceYearly       Float    @default(0.0) // SAR
  currency          String   @default("SAR")
  // Quotas
  maxProposals      Int      @default(10) // per month; -1 = unlimited
  maxDocuments      Int      @default(50)
  maxWorkspaces     Int      @default(1)
  maxTokensPerMonth Int      @default(500000) // LLM token budget
  maxStorageGb      Int      @default(5)
  maxSeats          Int? // seat limit per Req 3.8, null = unlimited governed by plan
  // Features
  featuresJson      String? // JSON array of feature flags
  isActive          Boolean  @default(true)
  isPublic          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions            Subscription[]
  paymentCheckouts         PaymentCheckout[]
  recurringProfiles        MyFatoorahRecurringProfile[]
  recurringCheckoutIntents RecurringCheckoutIntent[]
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  planId             String
  status             String    @default("ACTIVE") // PENDING | ACTIVE | PAST_DUE | CANCELLED | TRIALING | EXPIRED
  billingCycle       String    @default("MONTHLY") // MONTHLY | YEARLY
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  // Usage counters (reset each cycle)
  proposalsUsed      Int       @default(0)
  documentsUsed      Int       @default(0)
  tokensUsed         Int       @default(0)
  storageUsedBytes   Float     @default(0)
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user                     User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                     SubscriptionPlan             @relation(fields: [planId], references: [id])
  recurringProfiles        MyFatoorahRecurringProfile[]
  recurringCheckoutIntents RecurringCheckoutIntent[]

  @@index([status])
}

model BillingRecord {
  id                String   @id @default(cuid())
  userId            String
  type              String // SUBSCRIPTION | USAGE | TOPUP | REFUND | OVERAGE
  amount            Float // SAR
  currency          String   @default("SAR")
  description       String
  tokensIncluded    Int      @default(0)
  proposalsIncluded Int      @default(0)
  status            String   @default("PAID") // PENDING | PAID | FAILED | REFUNDED
  invoiceNumber     String?
  paymentMethod     String? // myfatoorah | mada | visa | mastercard | stc_pay | bank_transfer
  externalInvoiceId String? // MyFatoorah InvoiceId
  externalPaymentId String?
  metadata          String? // JSON
  createdAt         DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkout PaymentCheckout?

  @@index([userId])
  @@index([status])
  @@index([externalInvoiceId])
}

// MyFatoorah checkout sessions for self-serve plan purchase
model PaymentCheckout {
  id                String    @id @default(cuid())
  userId            String
  planId            String
  billingCycle      String // MONTHLY | YEARLY
  amount            Float
  currency          String    @default("SAR")
  status            String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED | CANCELLED
  customerReference String    @unique
  invoiceId         String? // MyFatoorah InvoiceId (stringified)
  paymentId         String?
  paymentUrl        String?
  billingRecordId   String?   @unique
  errorMessage      String?
  paidAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan @relation(fields: [planId], references: [id])
  billingRecord BillingRecord?   @relation(fields: [billingRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([invoiceId])
  @@index([status, createdAt, id])
}

// MyFatoorah Webhook V2 durable receipt + idempotency
model PaymentWebhookEvent {
  id                String    @id @default(cuid())
  eventFingerprint  String    @unique
  eventName         String?
  eventCode         Int?
  eventReference    String?
  invoiceId         String?
  paymentId         String?
  recurringId       String?
  customerReference String?
  signatureValid    Boolean   @default(false)
  processingStatus  String    @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED | DUPLICATE
  disposition       String?
  attempts          Int       @default(0)
  errorMessage      String?
  payloadRedacted   String? // JSON without secrets
  createdAt         DateTime  @default(now())
  processedAt       DateTime?

  @@index([processingStatus])
  @@index([invoiceId])
  @@index([recurringId])
  @@index([createdAt])
}

// MyFatoorah-managed recurring profiles (when merchant supports recurring)
model MyFatoorahRecurringProfile {
  id                String    @id @default(cuid())
  userId            String
  workspaceId       String?
  subscriptionId    String?
  planId            String?
  recurringId       String    @unique
  status            String    @default("DRAFT") // DRAFT | ACTIVE | SUSPENDED | CANCELLED; legacy values remain readable
  recurringType     String?
  intervalDays      Int?
  retryCount        Int       @default(3)
  amount            Float? // Legacy compatibility only; exact literal is authoritative when present
  amountExact       String?
  currency          String    @default("SAR")
  customerReference String?
  initialInvoiceId  String?
  nextChargeAt      DateTime? // estimated next charge date
  lastChargeAt      DateTime? // last successful charge
  failedCharges     Int       @default(0)
  lastFailureReason String?
  lastFailureAt     DateTime?
  lastWebhookAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  subscription Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId, status, createdAt, id])
  @@index([subscriptionId])
  @@index([subscriptionId, status])
  @@index([status])
}

model RecurringCheckoutIntent {
  id                String    @id @default(cuid())
  workspaceId       String
  subscriptionId    String
  planId            String
  createdById       String
  idempotencyKey    String
  billingCycle      String
  amountExact       String
  currency          String
  status            String    @default("PENDING") // PENDING | FINALIZED | FAILED | EXPIRED
  providerReference String?
  expiresAt         DateTime?
  finalizedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("RecurringCheckoutIntentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, idempotencyKey])
  @@index([workspaceId, status, createdAt, id])
  @@index([status, createdAt, id])
  @@index([providerReference])
}

// ─── Immutable Audit Trail ───────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // LOGIN | LOGOUT | CONFIG_CHANGE | DOC_UPLOAD | PROPOSAL_GENERATE | ROLE_CHANGE | ENV_UPDATE | BILLING_CHANGE
  resource   String? // affected entity type
  resourceId String? // affected entity id
  details    String? // JSON blob with before/after
  ipAddress  String?
  userAgent  String?
  severity   String   @default("INFO") // INFO | WARN | ERROR | CRITICAL
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ─── Account Onboarding Corpus (Phase 1 knowledge base) ──────────────────────

model Certificate {
  id                 String                @id @default(cuid())
  workspaceId        String
  certType           String // ISO | GOSI | VAT | ZAKAT | LICENSE | OTHER
  name               String
  number             String?
  issuer             String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  filePath           String?
  alertDays          Int                   @default(30)
  notes              String?
  approved           Boolean               @default(false)
  reviewStatus       KnowledgeReviewStatus @default(UNREVIEWED)
  evidenceRef        String?
  evidenceDocumentId String?
  evidenceVersion    Int?
  evidenceChecksum   String?
  provenanceJson     String?               @db.Text
  reviewedById       String?
  approvedAt         DateTime?
  decisionStatus     String                @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById      String?
  submittedAt        DateTime              @default(now())
  decisionAt         DateTime?
  decisionReasonAr   String?               @db.Text
  decisionReasonEn   String?               @db.Text
  revokedAt          DateTime?
  revokedById        String?
  revocationReason   String?               @db.Text
  contentHash        String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  workspace             Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewer              User?            @relation("CertificateReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  submitter             User?            @relation("CertificateSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  revoker               User?            @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  evidenceVersionRecord DocumentVersion? @relation("CertificateEvidence", fields: [evidenceDocumentId, evidenceVersion, evidenceChecksum], references: [documentId, version, checksum], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId])
  @@index([expiresAt])
  @@index([workspaceId, reviewStatus, approved])
  @@index([workspaceId, decisionStatus, submittedAt(sort: Desc), id])
  @@index([evidenceDocumentId, evidenceVersion])
}

model StaffMember {
  id                 String    @id @default(cuid())
  workspaceId        String
  name               String
  nameAr             String?
  roleTitle          String
  roleTitleAr        String?
  certifications     String?
  cvSummary          String?
  requirementTags    String? // JSON string[] e.g. ["ISO_27001_LEAD"]
  embeddingJson      String?
  active             Boolean   @default(true)
  decisionStatus     String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submittedById      String?
  submittedAt        DateTime  @default(now())
  reviewedById       String?
  decisionAt         DateTime?
  decisionReasonAr   String?   @db.Text
  decisionReasonEn   String?   @db.Text
  evidenceDocumentId String?
  evidenceVersion    Int?
  evidenceChecksum   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

