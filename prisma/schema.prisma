  evidenceVersionRecord DocumentVersion? @relation("StaffMemberEvidence", fields: [evidenceDocumentId, evidenceVersion, evidenceChecksum], references: [documentId, version, checksum], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId])
  @@index([workspaceId, decisionStatus, submittedAt(sort: Desc), id])
  @@index([evidenceDocumentId, evidenceVersion])
}

model MethodologyAsset {
