  revoker               User?            @relation("LibraryItemRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  evidenceVersionRecord DocumentVersion? @relation("LibraryItemEvidence", fields: [evidenceDocumentId, evidenceVersion, evidenceChecksum], references: [documentId, version, checksum], onDelete: Restrict, onUpdate: Restrict)

