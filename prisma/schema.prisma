// ─── Tender Requirements Matrix ──────────────────────────────────────────────

model TenderRequirement {
  id                 String   @id @default(cuid())
  projectId          String
  text               String
  sectionRef         String?
  pageRef            String?
  status             String   @default("MISSING") // COVERED | IN_PROGRESS | MISSING
  linkedResourceType String? // CERTIFICATE | STAFF | PAST_PROJECT | LIBRARY | METHODOLOGY
  linkedResourceId   String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project TenderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

// ─── Proposal Review Workflow ────────────────────────────────────────────────

model ProposalReview {
  id                        String    @id @default(cuid())
  proposalId                String
  stepIndex                 Int
  reviewerId                String
  stepRole                  String    @default("TECHNICAL") // TECHNICAL | FINAL
  status                    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  submissionHash            String?
  submittedProposalVersion  Int?
  submittedSnapshotHash     String?
  submittedSnapshotRevision Int?
  comment                   String?
  decidedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  proposal GeneratedProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  reviewer User              @relation(fields: [reviewerId], references: [id])

  @@unique([proposalId, stepIndex])
  @@index([proposalId, submissionHash])
  @@index([reviewerId])
  @@index([status])
}

// ─── Contract obligation done-state (server-persisted) ───────────────────────

model ContractObligationState {
  id           String   @id @default(cuid())
  proposalId   String
  obligationId String
  status       String   @default("open") // open | done
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  proposal  GeneratedProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  updatedBy User?             @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([proposalId, obligationId])
  @@index([proposalId])
}

// ─── Notification dismissals (per-user, cross-device) ─────────────────────────

model NotificationDismissal {
  id             String   @id @default(cuid())
  userId         String
  notificationId String
  dismissedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
}

// ─── Expiry notification dedupe log (cron emails) ────────────────────────────

model ExpiryNotificationLog {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String // CERT_EXPIRY | SUBSCRIPTION_EXPIRY
  resourceId  String
  channel     String   @default("email") // email | in_app
  sentAt      DateTime @default(now())
  metaJson    String?

  @@unique([workspaceId, kind, resourceId, channel])
  @@index([workspaceId])
  @@index([sentAt])
}

// ─── Contract Template System (Phase 3) ──────────────────────────────────────

model ContractTemplate {
  id                    String    @id @default(cuid())
  workspaceId           String
  type                  String
  catalogKey            String?
  nameEn                String
  nameAr                String
  descriptionEn         String?
  descriptionAr         String?
  version               String    @default("1.0")
  schemaVersion         Int       @default(1)
  canonicalHash         String?
  lifecycle             String    @default("DRAFT") // DRAFT | PUBLISHED | RETIRED
  legalReviewStatus     String    @default("UNREVIEWED") // UNREVIEWED | IN_REVIEW | APPROVED | REJECTED
  counselReviewRequired Boolean   @default(true)
  sourceStatus          String    @default("PENDING_OFFICIAL_SOURCE_REVIEW")
  provenanceJson        String?   @db.Text
  status                String    @default("draft") // Legacy compatibility; lifecycle is authoritative
  sectionsJson          String    @db.Text
  variablesJson         String    @db.Text
  clausesJson           String    @db.Text
  isSystem              Boolean   @default(false)
  isApproved            Boolean   @default(false)
  isExecutable          Boolean   @default(false)
  currentVersionNumber  Int?
  currentVersionId      String?   @unique
  retiredAt             DateTime?
  approvedBy            String?
  approvedAt            DateTime?
  createdBy             String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  workspace          Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator            User                      @relation("TemplateCreator", fields: [createdBy], references: [id])
  approver           User?                     @relation("TemplateApprover", fields: [approvedBy], references: [id])
  versions           ContractTemplateVersion[] @relation("ContractTemplateVersions")
  currentVersion     ContractTemplateVersion?  @relation("CurrentContractTemplateVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  generatedContracts GeneratedContract[]

  @@unique([workspaceId, catalogKey])
  @@index([workspaceId, type, status])
  @@index([workspaceId, isSystem])
  @@index([workspaceId, lifecycle, legalReviewStatus])
  @@index([workspaceId, lifecycle, createdAt, id])
}

model ContractTemplateVersion {
  id                    String   @id @default(cuid())
  templateId            String
  version               String
  versionNumber         Int?
  schemaVersion         Int      @default(1)
  canonicalHash         String?
  lifecycle             String   @default("DRAFT")
  legalReviewStatus     String   @default("UNREVIEWED")
  counselReviewRequired Boolean  @default(true)
  isExecutable          Boolean  @default(false)
  sourceStatus          String   @default("PENDING_OFFICIAL_SOURCE_REVIEW")
  provenanceJson        String?  @db.Text
  sectionsJson          String   @db.Text
  variablesJson         String   @db.Text
  clausesJson           String   @db.Text
  changeNote            String?
  createdBy             String
  createdAt             DateTime @default(now())

  template                  ContractTemplate           @relation("ContractTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  currentFor                ContractTemplate?          @relation("CurrentContractTemplateVersion")
  creator                   User                       @relation(fields: [createdBy], references: [id])
  generatedContracts        GeneratedContract[]
  generatedContractVersions GeneratedContractVersion[]

  @@unique([templateId, version])
  @@unique([templateId, versionNumber])
  @@unique([id, templateId])
  @@index([templateId, lifecycle, legalReviewStatus])
  @@index([templateId, versionNumber(sort: Desc), id])
}

model StandardClause {
  id                    String   @id @default(cuid())
  version               Int      @default(1)
  canonicalHash         String?
  lifecycle             String   @default("DRAFT")
  legalReviewStatus     String   @default("UNREVIEWED")
  counselReviewRequired Boolean  @default(true)
  sourceStatus          String   @default("PENDING_OFFICIAL_SOURCE_REVIEW")
  provenanceJson        String?  @db.Text
  translationStatus     String   @default("DRAFT")
  clauseKey             String?
  workspaceId           String?
  isCustom              Boolean  @default(false)
  category              String
  nameEn                String
  nameAr                String
  contentEn             String   @db.Text
  contentAr             String   @db.Text
  mandatory             Boolean  @default(false)
  customizable          Boolean  @default(true)
  saudiLawReference     String?
  order                 Int      @default(0)
  isSystem              Boolean  @default(true)
  isActive              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workspace Workspace? @relation("WorkspaceCustomClauses", fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, clauseKey])
  @@index([workspaceId, isCustom])
  @@index([clauseKey, isActive])
  @@index([category, isActive, workspaceId])
  @@index([category, isActive])
  @@index([lifecycle, legalReviewStatus])
  @@index([clauseKey])
}

model GeneratedContract {
  id                      String   @id @default(cuid())
  workspaceId             String
  templateId              String
  projectId               String?
  title                   String
  titleAr                 String
  dataJson                String   @db.Text
  clausesJson             String   @db.Text
  contentHtml             String   @db.Text
  documentSpecJson        String?  @db.Text
  templateVersionId       String?
  canonicalHash           String?
  legalReviewStatus       String   @default("UNREVIEWED")
  counselReviewRequired   Boolean  @default(true)
  isExecutable            Boolean  @default(false)
  contentPdfPath          String?
  status                  String   @default("draft")
  clientRequestId         String?
  generationSchemaVersion Int      @default(0)
  generationMode          String?
  diagnosticCount         Int      @default(0)
  storageBytes            Int      @default(0)
  createdBy               String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template        ContractTemplate           @relation(fields: [templateId], references: [id])
  templateVersion ContractTemplateVersion?   @relation(fields: [templateVersionId, templateId], references: [id, templateId])
  project         TenderProject?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator         User                       @relation(fields: [createdBy], references: [id])
  versions        GeneratedContractVersion[]

  @@unique([workspaceId, clientRequestId])
  @@index([workspaceId, status])
  @@index([templateId])
  @@index([projectId])
  @@index([workspaceId, legalReviewStatus, isExecutable])
  @@index([workspaceId, generationSchemaVersion, status, createdAt, id])
}

// =============================================================================
// Phase 4: Enhanced Proposal System
// =============================================================================

model ProposalBuilderSection {
  id             String   @id @default(cuid())
  proposalId     String
  sectionKey     String
  sectionType    String // cover, executive-summary, technical-approach, pricing, team, qualifications, timeline, compliance, appendix
  sortOrder      Int
  titleJson      Json // { ar: string, en: string }
  contentJson    Json // { ar: string, en: string } - markdown content per locale
  metadataJson   Json? // section-specific metadata (pricing rows, team members, etc.)
  isRequired     Boolean  @default(false)
  isVisible      Boolean  @default(true)
  validationJson Json? // validation rules and current status
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  proposal GeneratedProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  creator  User              @relation(fields: [createdBy], references: [id])

  @@unique([proposalId, sectionKey])
  @@index([proposalId, sortOrder])
  @@index([sectionType])
}

model TemplateMarketplaceEntry {
  id              String   @id @default(cuid())
  workspaceId     String? // null for system templates
  templateKey     String
  nameJson        Json // { ar: string, en: string }
  descriptionJson Json // { ar: string, en: string }
  category        String // construction, it, consulting, government, healthcare
  industry        String?
  sectionTypes    Json // array of section types included
  previewJson     Json? // sample data for preview
  rating          Float    @default(0)
  ratingCount     Int      @default(0)
  downloadCount   Int      @default(0)
  usageCount      Int      @default(0)
  isPublic        Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  isRetired       Boolean  @default(false)
  version         Int      @default(1)
  tags            Json? // array of tags
  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace?                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator      User                             @relation(fields: [createdBy], references: [id])
  ratings      TemplateMarketplaceRating[]
  applications TemplateMarketplaceApplication[]

  @@unique([workspaceId, templateKey])
  @@index([category, isPublic])
  @@index([rating, downloadCount])
  @@index([isFeatured, isPublic])
  @@index([isRetired])
  @@index([isRetired, isPublic, createdAt, id])
}

model CollaborationComment {
  id          String    @id @default(cuid())
  proposalId  String
  sectionKey  String? // null for general comments
  content     String    @db.Text
  mentions    Json? // array of user IDs mentioned
  isResolved  Boolean   @default(false)
  isWithdrawn Boolean   @default(false)
  parentId    String? // for threaded replies
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?

  proposal GeneratedProposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  creator  User                   @relation(fields: [createdBy], references: [id])
  parent   CollaborationComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  CollaborationComment[] @relation("CommentReplies")

  @@index([proposalId, sectionKey])
  @@index([proposalId, createdAt])
  @@index([proposalId, createdAt(sort: Desc), id])
  @@index([parentId])
  @@index([createdBy])
}

model AnalyticsEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  eventKey     String?  @unique
  eventType    String // closed vocabulary in analytics-collector.ts
  entityType   String
  entityId     String
  durationMs   Int?
  metadataJson Json? // minimized event-specific identifiers/counts only
  userId       String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workspaceId, eventType, createdAt])
  @@index([workspaceId, eventType, createdAt, id])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
}

// ─── Platform Completion Wave 1 ────────────────────────────────────────────

model VerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  hashSalt    String?
  hashVersion Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consumedAt, expiresAt])
  @@index([tokenHash])
  @@index([expiresAt])
}

model RecoveryToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  hashSalt    String?
  hashVersion Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, consumedAt, expiresAt])
  @@index([tokenHash])
  @@index([expiresAt])
}

model WorkspaceInvitation {
  id                 String    @id @default(cuid())
  workspaceId        String
  email              String
  role               String    @default("MEMBER")
  tokenHash          String    @unique
  hashSalt           String?
  hashVersion        Int       @default(0)
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  inviterId          String?
  emailDeliveryState String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User?     @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@index([workspaceId, consumedAt, revokedAt, createdAt(sort: Desc), id], map: "WorkspaceInvitation_workspaceId_state_createdAt_id_idx")
  @@index([email, consumedAt])
  @@index([tokenHash])
  @@index([inviterId])
  @@index([email])
}

model GeneratedContractVersion {
  id                    String   @id @default(cuid())
  contractId            String
  revision              Int
  templateVersionId     String?
  bindingsJson          String   @db.Text // Legacy combined binding snapshot
  variableValuesJson    String?  @db.Text
  selectedClauseIdsJson String?  @db.Text
  documentSpecJson      String?  @db.Text
  contentHtml           String   @db.Text
  canonicalHash         String?
  legalReviewStatus     String   @default("UNREVIEWED")
  counselReviewRequired Boolean  @default(true)
  isExecutable          Boolean  @default(false)
  createdBy             String
  createdAt             DateTime @default(now())

  contract        GeneratedContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  templateVersion ContractTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  creator         User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([contractId, revision])
  @@index([contractId, revision])
  @@index([contractId, revision(sort: Desc), id], map: "GeneratedContractVersion_contractId_revision_id_cursor_idx")
  @@index([templateVersionId])
  @@index([createdBy])
}

model NotificationDelivery {
  id                 String    @id @default(cuid())
  workspaceId        String?
  eventId            String
  recipientId        String
  channel            String    @default("email")
  status             String    @default("PENDING")
  recipientEmail     String?
  recipientLocale    String?
  templateKey        String?
  payloadJson        Json?
  attemptCount       Int       @default(0)
  nextAttemptAt      DateTime?
  firstAttemptAt     DateTime?
  lastAttemptAt      DateTime?
  claimedAt          DateTime?
  claimExpiresAt     DateTime?
  claimedBy          String?
  deliveryDeadlineAt DateTime?
  providerMessageId  String?
  deliveredAt        DateTime?
  failedAt           DateTime?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  recipient User       @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  // Uniqueness is per delivery channel: one event fans out to an in-app row and
  // an email row for the same recipient. A two-column key on
  // (eventId, recipientId) subsumes this one and makes the second channel
  // insert fail with P2002, so it must not be reintroduced.
  @@unique([eventId, recipientId, channel])
  @@index([workspaceId, createdAt])
  @@index([recipientId, createdAt])
  @@index([eventId])
  @@index([status, nextAttemptAt, claimExpiresAt, id])
  @@index([claimedAt, claimExpiresAt])
}

model TemplateMarketplaceRating {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  /// 1–5 integer rating. DB-level CHECK constraint enforced in
  /// prisma/migrations/20260729100000_marketplace_rating_check/migration.sql
  /// App-level validation: z.number().int().min(1).max(5) in the rate route.
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entry TemplateMarketplaceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([entryId, rating])
  @@index([userId])
}

model TemplateMarketplaceApplication {
  id          String   @id @default(cuid())
  entryId     String
  proposalId  String
  workspaceId String
  appliedById String
  createdAt   DateTime @default(now())

  entry     TemplateMarketplaceEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  proposal  GeneratedProposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  workspace Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appliedBy User                     @relation("MarketplaceApplicationActor", fields: [appliedById], references: [id], onDelete: Restrict)

  @@unique([entryId, proposalId])
  @@index([workspaceId, createdAt, id])
  @@index([proposalId])
  @@index([appliedById])
}

model ProposalPresence {
  id          String   @id @default(cuid())
  proposalId  String
  userId      String
  workspaceId String
  lastSeenAt  DateTime @default(now())
  sectionKey  String?

  proposal  GeneratedProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([proposalId, userId])
  @@index([proposalId, lastSeenAt])
  @@index([proposalId, lastSeenAt, id])
  @@index([workspaceId])
  @@index([workspaceId, lastSeenAt])
  @@index([lastSeenAt])
  @@index([userId])
}

model InAppNotification {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  type        String
  titleEn     String
  titleAr     String
  bodyEn      String   @db.Text
  bodyAr      String   @db.Text
  href        String?
  eventId     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([workspaceId, userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, createdAt(sort: Desc), id], map: "InAppNotification_userId_createdAt_id_cursor_idx")
  @@index([eventId])
}
