{
  "manifest_version": 3,
  "name": "ArabClue Agent",
  "version": "3.1.0",
  "description": "Futuristic AI browser agent for ArabClue Mission Control: Etimad tender intelligence, universal page capture, copilot chat, and document uplink.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open ArabClue Agent",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms",
    "notifications",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://arabclue.com/*",
    "https://*.arabclue.com/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://tenders.etimad.sa/*",
    "https://*.etimad.sa/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://arabclue.com/*",
      "https://*.arabclue.com/*",
      "https://*.vercel.app/*",
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://arabclue.com/*",
        "https://*.arabclue.com/*",
        "https://*.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content/arabclue-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tenders.etimad.sa/*",
        "https://*.etimad.sa/*"
      ],
      "js": ["content/etimad-parser.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http://localhost:3000 http://127.0.0.1:3000"
  },
  "commands": {
    "scan-etimad": {
      "suggested_key": { "default": "Ctrl+Shift+E", "mac": "MacCtrl+Shift+E" },
      "description": "Scan Etimad for tenders"
    },
    "prepare-proposal": {
      "suggested_key": { "default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P" },
      "description": "Extract and prepare proposal from current tender"
    }
  }
}
