{
  "name": "arabclue-platform",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "bun run db:ensure && next dev -p 3000",
    "dev:log": "next dev -p 3000 2>&1 | tee dev.log",
    "dev:setup": "bun run db:ensure && bun run db:generate && echo '✅ Local files and Prisma client are ready — shared database schema unchanged'",
    "dev:clean": "rm -rf .next dev.log && bun run db:ensure && bun run db:generate",
    "pack:extension": "bun scripts/pack-extension.mjs",
    "samples:docs": "bun scripts/generate-sample-documents.mjs",
    "build": "node scripts/ensure-extension-packed.mjs && prisma generate && next build && node scripts/check-bilingual-font-traces.mjs",
    "scan:integrity": "bun scripts/scan-integrity.ts",
    "build:vercel": "bun run build",
    "build:standalone": "STANDALONE=1 bun run pack:extension && STANDALONE=1 prisma generate && STANDALONE=1 next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "deploy:safety": "bun scripts/check-deployment-safety.mjs --scope=deploy",
    "deploy:safety:repo": "bun scripts/check-deployment-safety.mjs --scope=repo",
    "deploy:check": "bun run deploy:safety && bun run lint && bun run test && bun run build",
    "setup:pdf": "bunx playwright install chromium",
    "test:pdf": "PLAYWRIGHT_CHROMIUM=1 bun test src/lib/__tests__/pdf-generation.test.ts",
    "test:bilingual": "bun test src/lib/__tests__/bilingual-layout.test.ts src/lib/__tests__/layout-sync.test.ts src/lib/__tests__/bilingual-typography.test.ts src/lib/__tests__/bilingual-components.test.tsx src/lib/__tests__/bilingual-pdf.test.ts src/lib/__tests__/contract-export-bilingual.test.ts",
    "test:bilingual:visual": "PLAYWRIGHT_CHROMIUM=1 bun test src/lib/__tests__/bilingual-visual.test.ts src/lib/__tests__/bilingual-pdf.test.ts",
    "update:bilingual:visual-baseline": "UPDATE_BILINGUAL_VISUAL_BASELINE=1 PLAYWRIGHT_CHROMIUM=1 bun test src/lib/__tests__/bilingual-visual.test.ts --timeout=120000",
    "setup:bilingual:browsers": "bunx playwright install chromium firefox webkit",
    "test:bilingual:browsers": "bun scripts/run-bilingual-browser-matrix.ts",
    "benchmark:bilingual": "PLAYWRIGHT_CHROMIUM=1 bun test src/lib/__tests__/bilingual-performance.test.ts",
    "samples:bilingual": "bun scripts/generate-bilingual-qa-artifact.ts",
    "quality:documents": "bun scripts/check-document-quality.ts",
    "start": "next start",
    "start:standalone": "NODE_ENV=production node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "test": "bun test --preload ./src/lib/__tests__/support/completion-test-preload.ts src/lib/__tests-isolated && bun test --preload ./src/lib/__tests__/support/completion-test-preload.ts src/lib/__tests__",
    "test:completion": "bun test --preload ./src/lib/__tests__/support/completion-test-preload.ts src/lib/__tests__/platform-completion",
    "test:completion:db": "COMPLETION_USE_TEST_DATABASE=1 bun test --preload ./src/lib/__tests__/support/completion-test-preload.ts src/lib/__tests__/platform-completion",
    "test:e2e:completion": "playwright test --config playwright.completion.config.ts",
    "seed:clauses": "bun run src/lib/seeds/seed-clauses.ts",
    "db:ensure": "mkdir -p db uploads && touch db/.gitkeep && touch uploads/.gitkeep",
    "db:push": "prisma db push",
    "db:push:dev": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
