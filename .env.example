# ── ArabClue local / production ──
# Copy this to .env and fill secrets. Never commit .env.

# 1) Database — Neon Postgres (pooled URL recommended for serverless)
# Local: postgresql://USER:PASSWORD@localhost:5432/arabclue?schema=public
# Neon:  postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arabclue?schema=public"
# Migrations: `bun run db:migrate:deploy` must run against the UNPOOLED Neon
# connection (the host without "-pooler"; Neon shows it as DATABASE_URL_UNPOOLED).
# The pgbouncer-pooled URL breaks Prisma's advisory lock and prepared statements
# during `migrate deploy`. Run it as a separate, approved release step, never
# from the Vercel build:
#   DATABASE_URL="$DATABASE_URL_UNPOOLED" bun run db:migrate:deploy

# 2) NextAuth — canonical URL + secret (use `openssl rand -base64 32`)
# Production: https://arabclue.com
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-string-min-32-chars"

# 3) Bootstrap admin (first seed only) — password min 10 chars
BOOTSTRAP_ADMIN_EMAIL="admin@arabclue.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-strong-password-min-10"

# Temporary: skip email verification gates + verification emails (local/dev only)
# SKIP_EMAIL_VERIFICATION=true

# 4) Encrypts admin EnvSetting values (AES-256-GCM) — required in production
ARABCLUE_ENC_KEY="replace-with-long-random-encryption-key-32+chars"

# 5) Vercel Blob (production uploads) — set via Vercel storage integration
# BLOB_READ_WRITE_TOKEN=

# 6) Redis — required in production on Vercel for distributed auth/export rate
# limiting (/api/ready reports rateLimit "REDIS_URL_missing_on_vercel" and fails
# readiness without it). A single-node self-host may run on the memory limiter.
# REDIS_URL=

# Reverse proxies between the client and this process that append to
# X-Forwarded-For. Vercel writes the single true client address, so the default
# of 1 is right there and for one nginx in front of a standalone server; use 2
# for Cloudflare -> nginx -> app, and 0 to ignore forwarded headers entirely
# (no trusted proxy: they would be client-controlled).
# TRUSTED_PROXY_HOPS=1

# 7) Cron authentication — required in production (minimum 16 characters)
# CRON_SECRET=

# 8) Transactional email — REQUIRED for signup to work at all.
# Without a transport, verification mail cannot be sent and a new account can
# never clear the email-verification gate. Pick ONE of the two:
#   a) Resend HTTP API (preferred on serverless — no long-lived socket)
# RESEND_API_KEY=
#   b) SMTP relay (e.g. a Hostinger mailbox). All three are required together.
#      Port 465 = implicit TLS (default). Port 587 = STARTTLS.
#      Vercel blocks outbound port 25 only; 465 and 587 work on the Node runtime.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@example.com
# SMTP_PASSWORD=
# From address. An SMTP relay rejects an address it does not own, so this must
# be the authenticated mailbox (or a verified alias of it).
# EMAIL_FROM="ArabClue <info@example.com>"

# 9) Optional LLM providers (also configurable in Admin → AI Providers UI)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ZAI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Every AI helper has a keyword/template branch it can take when the provider
# call degrades, and its output is shaped exactly like a real answer. Leave this
# unset (or set to anything but the values below) and the app refuses instead,
# surfacing "connect a provider" rather than passing templated text off as model
# output. Set to 0/false/no/off ONLY to accept fabricated answers.
# AUTONOMY_REAL_AI_ONLY=

# 9b) Live web research (optional). With a Tavily key the compliance, drafting
# and contract agents add dated, source-linked web passages (official Saudi
# domains boosted) on top of the reviewed regulatory registry, and the platform
# agent gains a read-only searchWeb tool. Also settable in Admin → Environment.
# TAVILY_API_KEY=

# 10) MyFatoorah payments (Saudi VAT/compliant)
# Test: https://apitest.myfatoorah.com
# Live SA: https://api-sa.myfatoorah.com
# MYFATOORAH_API_KEY=
# MYFATOORAH_API_URL=https://apitest.myfatoorah.com
# MYFATOORAH_WEBHOOK_SECRET=

# 11) Optional local overrides
# NODE_ENV=development
# PORT=3000

# Vercel Workflow (agent pipeline steps, src/lib/agents/pipeline-workflow.ts).
# No variable is needed: `next dev` runs the "local world", which stores run
# state under .next/workflow-data/ (gitignored) and executes steps in-process;
# on Vercel the "vercel world" is selected automatically. Inspect local runs
# with `bunx workflow inspect runs`. Only set WORKFLOW_TARGET_WORLD when
# self-hosting with a different world (e.g. @workflow/world-postgres).
# WORKFLOW_TARGET_WORLD=

# 12) Completion tests — isolated PostgreSQL only
# The guarded database suite additionally requires TEST_DATABASE_ISOLATED=true.
# TEST_DATABASE_IDENTITY must exactly match the credential-free identity derived
# from TEST_DATABASE_URL (host:port/database?schema=...). Never reuse DATABASE_URL.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/arabclue_completion_test?schema=public"
# TEST_DATABASE_IDENTITY="localhost:5432/arabclue_completion_test?schema=public"
# TEST_DATABASE_ISOLATED=true