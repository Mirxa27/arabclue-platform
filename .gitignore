# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local and deployment environment files must never be committed.
.env*
!.env.example

# vercel
.vercel

# generated admin credentials — never commit
admin-credentials.json
.env.admin

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

# uploads
/uploads/

# local sqlite databases
/db/*.db
/db/*.db-journal

server.log
# Skills directory
/skills/

# agent session metadata (never commit)
.reasonix/

# Vercel
.vercel
prisma/template.db
public/downloads/*.zip

# Runtime artifacts
dev.pid
test-results/

# Isolated git worktrees
.worktrees/
